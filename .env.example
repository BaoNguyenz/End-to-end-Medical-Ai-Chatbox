# === Local Qwen3 via llama.cpp (OpenAI-compatible API) ===
LLM_BASE_URL=http://127.0.0.1:11435/v1
LLM_MODEL=Qwen/Qwen3-8B-GGUF:Q4_K_M
LLM_API_KEY=local

# === Embedding Model ===
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Cross-Encoder Model ===
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# === Qdrant Vector Database ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_docs

# === Neo4j Graph Database ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# === HNSW Parameters ===
HNSW_M=32
HNSW_EF_CONSTRUCT=200
HNSW_EF_SEARCH=100

# === Chunking Parameters ===
CHUNK_SIMILARITY_THRESHOLD=0.75
CHUNK_MAX_SIZE=1000
CHUNK_MIN_SIZE=100

# === Search Parameters ===
BM25_TOP_K=50
VECTOR_TOP_K=50
HYBRID_TOP_K=20
RERANK_TOP_K=10
RRF_K=60
MMR_LAMBDA=0.5
